{
  "version": 2,
  "configurePresets": [
    {
      "name": "playground",
      "displayName": "Playground",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-playground",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "playground-release",
      "displayName": "Playground Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-playground-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "playground",
      "configurePreset": "playground",
      "targets": ["playground", "reflection_preview"]
    },
    {
      "name": "playground-release",
      "configurePreset": "playground-release",
      "targets": ["playground", "reflection_preview"]
    }
  ]
}
